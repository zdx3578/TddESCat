{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v1/event.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "before_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "command_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "action": {
      "$ref": "common.schema.json#/$defs/action"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_blob": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completion": {
      "const": "confirmed"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "frame_shapes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },
    "prediction_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version_refs": {
      "type": "object",
      "properties": {
        "game": {
          "type": "string",
          "minLength": 1
        },
        "response_parser": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "interpretation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "library": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mechanism": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "game",
        "response_parser",
        "interpretation",
        "signature",
        "library",
        "mechanism",
        "context"
      ],
      "additionalProperties": false
    },
    "intervention_group": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "before_ref",
    "command_ref",
    "action",
    "request_sha256",
    "response_blob",
    "completion",
    "frame_count",
    "frame_shapes",
    "prediction_ref",
    "version_refs",
    "intervention_group"
  ],
  "additionalProperties": false
}
