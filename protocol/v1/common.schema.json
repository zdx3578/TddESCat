{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v1/common.schema.json",
  "$defs": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                7
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": 6
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          },
          "required": [
            "id",
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
