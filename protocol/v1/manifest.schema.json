{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "worktree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locks": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "julia": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rust": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "python",
        "julia",
        "rust"
      ],
      "additionalProperties": false
    },
    "environment": {
      "enum": [
        "protocol_stub",
        "synthetic_official_http",
        "official_offline_http",
        "offline",
        "real_public"
      ]
    },
    "isolation": {
      "enum": [
        "linux_namespaces",
        "local_development"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "suite_id",
    "git_commit",
    "worktree_sha256",
    "config_sha256",
    "locks",
    "environment",
    "isolation",
    "started_at"
  ],
  "additionalProperties": false
}
