{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v1/command.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "open_scorecard",
        "reset",
        "action",
        "close_scorecard"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^/api/(?:scorecard/(?:open|close)|cmd/(?:RESET|ACTION[1-7]))$"
    },
    "request_body": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_game_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_guid": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "before_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prediction_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completion": {
      "enum": [
        "prepared",
        "sent",
        "confirmed",
        "outcome_unknown",
        "explicit_rejection"
      ]
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "response_blob": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "sequence",
    "kind",
    "path",
    "request_body",
    "request_sha256",
    "expected_game_id",
    "expected_guid",
    "before_ref",
    "prediction_ref",
    "completion"
  ],
  "additionalProperties": false
}
