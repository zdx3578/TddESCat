{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v1/signature.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "signature_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sorts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^(?!(?:programs|lam)$|(?:fn_|lib_))[^\\s()$?]+$"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "output": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "purity": {
            "const": "pure"
          },
          "read_rule": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "binder_children": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 0
          }
        },
        "required": [
          "symbol",
          "inputs",
          "output",
          "purity",
          "read_rule",
          "binder_children"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "signature_id",
    "sorts",
    "operators"
  ],
  "additionalProperties": false
}
