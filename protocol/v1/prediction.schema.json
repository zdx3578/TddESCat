{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v1/prediction.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slot",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "event_reads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "action": {
      "$ref": "common.schema.json#/$defs/action"
    },
    "guard_truth": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "query_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "predicted_values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "enumeration_complete": {
      "type": "boolean"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_before_command": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "command_id",
        "sequence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "model_version",
    "binding",
    "action",
    "guard_truth",
    "query_scope",
    "predicted_values",
    "enumeration_complete",
    "assumptions",
    "created_before_command"
  ],
  "additionalProperties": false
}
