{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v1/typed_terms.schema.json",
  "$defs": {
    "const": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "Const"
        },
        "sort": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "value": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "kind",
        "sort",
        "value"
      ],
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "sort": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "time_role": {
          "enum": [
            "before",
            "after",
            "timeless"
          ]
        },
        "role_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "relation": {
                "enum": [
                  "same",
                  "distinct"
                ]
              },
              "other_slot": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "relation",
              "other_slot"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "index",
        "sort",
        "time_role",
        "role_constraints"
      ],
      "additionalProperties": false
    },
    "program_term": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Slot"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/const"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Call"
            },
            "operator": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/program_term"
              }
            }
          },
          "required": [
            "kind",
            "operator",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "definition_term": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Param"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/const"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Call"
            },
            "operator": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/definition_term"
              }
            }
          },
          "required": [
            "kind",
            "operator",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "left_term": {
          "$ref": "typed_terms.schema.json#/$defs/definition_term"
        },
        "right_term": {
          "$ref": "typed_terms.schema.json#/$defs/definition_term"
        },
        "parameter_sorts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        }
      },
      "required": [
        "rule_id",
        "left_term",
        "right_term",
        "parameter_sorts"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "program_index": {
          "type": "integer",
          "minimum": 0
        },
        "expression_path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "occurrence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "event_ref": {
          "type": "string",
          "minLength": 1
        },
        "interpretation_ref": {
          "type": "string",
          "minLength": 1
        },
        "slot_bindings_ref": {
          "type": "string",
          "minLength": 1
        },
        "support_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "program_index",
        "expression_path",
        "occurrence_id",
        "event_ref",
        "interpretation_ref",
        "slot_bindings_ref",
        "support_ref"
      ],
      "additionalProperties": false
    }
  }
}
