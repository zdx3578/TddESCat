{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "intent": {
      "enum": [
        "effect",
        "relation",
        "program",
        "symbolic"
      ]
    },
    "consumer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "maxLength": 256
    },
    "obligation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "program_index": {
            "type": "integer",
            "minimum": 0
          },
          "sort": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "maxLength": 256
          },
          "event_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "maxLength": 256
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scope_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "maxLength": 256
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "program_index",
          "sort",
          "event_refs",
          "scope_refs"
        ],
        "additionalProperties": false
      }
    },
    "constructions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "maxLength": 256
          },
          "operator": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "maxLength": 256
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "scope": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "operator",
          "parents",
          "scope"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "intent",
    "consumer",
    "obligation_refs",
    "programs",
    "constructions"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.tddescat.org/v3/semantic_context.schema.json"
}
