{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v3/definition.schema.json",
  "type": "object",
  "properties": {
    "temporary_name": {
      "type": "string",
      "pattern": "^fn_(0|[1-9][0-9]*)$"
    },
    "arity": {
      "type": "integer",
      "minimum": 0
    },
    "parameter_sorts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "result_sort": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "parameter_reads": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "body": {
      "$ref": "../v1/typed_terms.schema.json#/$defs/definition_term"
    },
    "pattern_text": {
      "type": "string",
      "minLength": 1
    },
    "closed_lambda_text": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "body_cost": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "temporary_name",
    "arity",
    "parameter_sorts",
    "result_sort",
    "parameter_reads",
    "body",
    "pattern_text",
    "closed_lambda_text",
    "dependencies",
    "body_cost",
    "semantic_digest"
  ],
  "additionalProperties": false
}
