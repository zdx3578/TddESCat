{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tddescat.org/v2/learn_summary.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "tddescat.learn.v2"
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "termination_reason": {
      "type": "string",
      "minLength": 1
    },
    "search_rounds": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_definitions": {
      "type": "integer",
      "minimum": 0
    },
    "total_heap_pops": {
      "type": "integer",
      "minimum": 0
    },
    "last_checkpoint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "round_index": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "round_index",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fixed_point": {
      "type": "boolean"
    },
    "scope_refs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "effective_policy": {
      "type": [
        "object",
        "null"
      ]
    },
    "effective_limits": {
      "type": "object",
      "properties": {
        "search_steps": {
          "type": "null"
        },
        "wall_ms": {
          "type": "null"
        },
        "max_relation_nodes": {
          "type": "null"
        },
        "max_egraph_nodes": {
          "type": "null"
        },
        "max_arena_states": {
          "type": "null"
        },
        "proof_visits": {
          "type": "null"
        },
        "managed_bytes": {
          "type": "null"
        },
        "output_bytes": {
          "type": "null"
        },
        "rounds": {
          "type": "null"
        },
        "library_size": {
          "type": "null"
        }
      },
      "required": [
        "search_steps",
        "wall_ms",
        "max_relation_nodes",
        "max_egraph_nodes",
        "max_arena_states",
        "proof_visits",
        "managed_bytes",
        "output_bytes",
        "rounds",
        "library_size"
      ],
      "additionalProperties": false
    },
    "interrupted_phase": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "protocol_version",
    "input_sha256",
    "termination_reason",
    "search_rounds",
    "accepted_definitions",
    "total_heap_pops",
    "last_checkpoint",
    "fixed_point",
    "scope_refs",
    "effective_policy",
    "effective_limits",
    "interrupted_phase"
  ],
  "additionalProperties": false
}
